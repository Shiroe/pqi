# ============================================================================
# PQI — Environment Configuration
# ============================================================================
#
# HOW THIS WORKS
# --------------
# 1. Copy this file to .env:  cp .env.example .env
# 2. Fill in the REQUIRED keys (marked below).
# 3. Every other key is OPTIONAL — delete the line to use the default shown.
#
# RULE: every value you can tune without touching code lives here.
#   config.py reads each key via os.getenv(KEY, default).
#   The default shown in this file IS the same default used by config.py.
#   Your .env overrides config.py's defaults.
#   config.py's Python literals are only for true code constants
#   (API base URLs, valid enum sets) — those never appear here.
#
# ============================================================================

# --- LLM BACKEND ------------------------------------------------------------

# Which LLM service to use for the Council of Seven.
# Valid values: ollama  (free, local GPU)  |  anthropic  (paid API)
# Default: ollama
LLM_BACKEND=ollama

# --- Ollama settings (used when LLM_BACKEND=ollama) -------------------------

# Name of the Ollama model to use. Must be pulled locally: `ollama pull <name>`
# Default: llama3.1:8b
OLLAMA_MODEL=llama3.1:8b

# URL of your local Ollama server.
# Default: http://localhost:11434
OLLAMA_BASE_URL=http://localhost:11434

# How many council agents can run LLM calls concurrently when using Ollama.
# Keep at 1 on consumer GPUs (8 GB VRAM) to avoid out-of-memory crashes.
# Has no effect when LLM_BACKEND=anthropic — API calls always run fully in parallel.
# Default: 1
LOCAL_LLM_CONCURRENCY=1

# --- Anthropic settings (used when LLM_BACKEND=anthropic) -------------------

# [REQUIRED when LLM_BACKEND=anthropic]
# Your Anthropic API key. Also accepted as CLAUDE_API_KEY (legacy alias).
ANTHROPIC_API_KEY=

# Model ID to use for Anthropic calls.
# claude-haiku-3-5 costs ~$0.015 per full council run — stays under $20/mo
# at typical usage. Upgrade to claude-sonnet-4-6 for better reasoning quality.
# Default: claude-haiku-3-5
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Wrap the system prompt in an ephemeral cache block (5-minute TTL).
# When true, repeated calls within 5 minutes that share the same system
# prompt are billed at ~10% of normal input price (cache reads). Biggest
# wins are across-run reuse of the council's stable persona prompts and
# the synthesizer's system prompt. Below the model's minimum cacheable
# prefix length the cache_control field is a silent no-op. Disable only
# for debugging.
# Default: true
ANTHROPIC_PROMPT_CACHE_ENABLED=true

# Maximum output tokens per Anthropic call. The council's JSON verdict must
# fit entirely within this budget — hitting the ceiling mid-response causes
# unterminated-string JSON parse failures that burn retries.
# Option B (two-sided probability) pushed typical verdict length past 1024,
# so 2048 is the new safe default. Raise to 4096 if agents still truncate
# under an unusually long briefing. Claude Haiku 4.5 supports up to 8192.
# Default: 2048
ANTHROPIC_MAX_TOKENS=2048

# --- Anthropic retry (centralized in pqi/llm/client.py) ---------------------
#
# Every Anthropic call is wrapped with an exponential-backoff retry loop that
# catches transient errors before they reach the council. This protects the
# pipeline from occasional 529 overloaded_error (Anthropic load shedding),
# 429 rate limits, dropped TCP connections and read timeouts. The SDK's
# built-in auto-retry is disabled (max_retries=0 on the client) so this layer
# owns the policy end-to-end — no double retries, no surprise jitter.

# Max additional retries per Anthropic call after the first attempt.
# Mirrors AGENT_MAX_RETRIES so council-level and client-level budgets line
# up. A total of 6 attempts (1 + 5 retries) covers multi-minute Anthropic
# incidents without hanging indefinitely.
# Default: 5
ANTHROPIC_MAX_RETRIES=5

# Base delay (seconds) for exponential backoff: delay = base * 2**attempt,
# capped at ANTHROPIC_RETRY_MAX_DELAY. 1.0s gives 1, 2, 4, 8, 16, 30 (cap).
# Default: 1.0
ANTHROPIC_RETRY_BASE_DELAY=1.0

# Cap on the per-attempt backoff (seconds). Matches AGENT_MAX_RETRIES' 30s
# cap so worst-case cumulative wait at the default 5 retries is ~61s.
# Default: 30.0
ANTHROPIC_RETRY_MAX_DELAY=30.0

# --- News / search ----------------------------------------------------------

# [REQUIRED]
# Tavily search API key. Used by the synthesizer to gather news per market.
# Free tier: 1 000 searches / month. Get a key at https://tavily.com
TAVILY_API_KEY=

# --- Tavily search tuning ---------------------------------------------------

# How many Tavily searches to run per market analysis.
# More searches = richer briefing but uses free-tier quota faster (1000/month).
# Default: 5
TAVILY_SEARCHES_PER_MARKET=5

# Maximum characters of raw search snippets sent to the LLM for synthesis.
# Higher = more context but more tokens. Default: 5000
TAVILY_SNIPPET_CAP=5000

# --- PandaScore (structured esports data) ----------------------------------

# When PANDASCORE_ENABLED is true and a key is set, the synthesizer attempts
# to resolve esports markets to PandaScore's structured match record (canonical
# team names, scheduled time, status, head-to-head, recent form). Result is
# attached to the briefing as `structured_match` and surfaced to the council
# under STRUCTURED MATCH DATA. All failure modes (no candidate, API error,
# low fuzzy confidence) are non-fatal — the pipeline silently falls back to
# the Tavily-only briefing.

# Your PandaScore API token. Free-tier accounts are sufficient for our
# read-only usage (~1000 req/hour). Get one at https://pandascore.co
# Empty string leaves the resolver disabled regardless of PANDASCORE_ENABLED.
PANDASCORE_API_KEY=

# Master switch for the structured-data resolver. Setting this to false
# keeps the key configured but disables the resolver (e.g. for an A/B
# comparison run against the Tavily-only baseline).
# Default: true
PANDASCORE_ENABLED=true

# Minimum rapidfuzz token_set_ratio confidence (0-100) for the
# market-question → PandaScore-match resolution to be accepted. Below
# this the resolver returns None and the briefing falls back to
# Tavily-only. 80 is intentionally conservative — false positives
# (wrong match attached to briefing) are far costlier than false
# negatives (no structured data attached). Lower if you start seeing
# legitimate matches dropped; raise if you see wrong matches attached.
# Default: 80
PANDASCORE_FUZZY_THRESHOLD=80

# Symmetric window (in hours) around the market's event_start_time
# in which PandaScore matches are considered candidates. Tight enough
# to avoid pulling a different scheduled meeting between the same
# parties, wide enough to absorb scheduling drift between Polymarket
# and PandaScore.
# Default: 3.0
PANDASCORE_WINDOW_HOURS=3.0

# How many recent completed matches per team to inspect when computing
# the team-form snapshot in the structured record.
# Default: 10
PANDASCORE_RECENT_FORM_COUNT=10

# --- Event enrichment -------------------------------------------------------

# Maximum number of parallel GET /events/{id} detail calls made after the
# initial list fetch. Detail fetches provide reliable live/ended/score data
# that the list endpoint omits. Higher = better data but more API calls.
# Default: 30
EVENT_ENRICHMENT_MAX=30

# --- CLOB price history -----------------------------------------------------

# Time window for price history fetched from the CLOB API before analysis.
# Provides trend/momentum context to the council agents.
# Valid values: 1d, 1w, 1m (per CLOB API docs). Default: 1w
PRICE_HISTORY_INTERVAL=1w

# Granularity in minutes. 60 = one data point per hour.
# Lower values give more data but may be noisier for trend analysis.
# Default: 60
PRICE_HISTORY_FIDELITY=60

# --- Market fetching --------------------------------------------------------

# How many markets to show in the selection list.
# Default: 20
MAX_MARKETS_TO_FETCH=20

# Minimum total trading volume (USD) a market must have to appear in the list.
# Filters out thinly traded markets where prices may not reflect real information.
# Applies to general queries (no --resolve-within flag).
# Default: 10000
MIN_VOLUME_USD=5000

# When --resolve-within is used, markets resolving within this many hours are
# considered "short window" and use the MIN_VOLUME_SHORT_WINDOW_USD floor instead.
# Default: 4
SHORT_WINDOW_HOURS=4

# Volume floor applied to short-window queries (see SHORT_WINDOW_HOURS).
# Freshly opened recurring markets (e.g. the next BTC 15-min window) start
# with $0 volume. Set this lower to see live esports/sports matches with
# low volume. Set equal to MIN_VOLUME_USD if you don't want different treatment.
# Default: 500
MIN_VOLUME_SHORT_WINDOW_USD=500

# Seconds to wait between Polymarket API requests (rate-limit courtesy delay).
# Increase if you see 429 errors. Rarely needs changing.
# Default: 0.5
GAMMA_RATE_LIMIT_DELAY=0.5

# --- Scoring: edge threshold ------------------------------------------------

# The council's probability estimate must differ from the market price by at
# least this many percentage points (0.0–1.0 scale) before a BUY is issued.
#
# Example: market says YES = 50%.  Council says YES = 59%.
#   edge = 0.59 - 0.50 = 0.09  →  exactly at the default threshold → BUY.
#
# DEPRECATED / informational only — `edge` / `no_edge` were repurposed in
# session 23 to `PerceivedTrueWinRate − side_price` and the EV gate (below)
# is the real -EV filter. This key is consumed by config.py purely so existing
# .env files don't error on import; the value is never read by scoring.
# Default: 0.09
EDGE_THRESHOLD=0.09

# --- Scoring: price floor / ceiling -----------------------------------------

# The side being recommended (YES or NO) must cost at least this many dollars
# per share for a BUY signal to be issued.
#
# Example: BUY NO at $0.01/share → downgraded to PASS.
# Rationale: a price near $0.00 means the market considers that outcome
# essentially impossible; realistic reversals become implausible.
# Valid range: 0.01–0.20.  Default: 0.09
MIN_TRADEABLE_PRICE=0.09

# Symmetric ceiling. Above this price the side is considered near-resolved
# and the ROI doesn't justify execution risk. Example: a side at $0.92 has a
# max ROI of only 8.7%, and execution spread often eats most of that.
# Valid range: 0.80–0.98.  Default: 0.90
MAX_TRADEABLE_PRICE=0.90

# --- Scoring: ROI gates -----------------------------------------------------

# Minimum max ROI for a market-aligned BUY. Max ROI = (1 - price) / price,
# i.e. the percentage gain if the recommended side wins.
# Example: side at $0.67 → max ROI 49%; side at $0.80 → max ROI 25%.
# This is the primary profitability gate. Raising it filters to cheaper
# (higher-upside) sides; lowering it accepts more expensive reads.
# Default: 0.10 (equivalent to price ≤ 0.91)
MIN_EXPECTED_ROI=0.10

# Stricter ROI floor for contrarian BUYs (mirrors the stricter probability
# and confidence gates that already exist for contrarian calls).
# Default: 0.20 (equivalent to price ≤ 0.833)
MIN_CONTRARIAN_ROI=0.20

# --- Scoring: confidence gates ----------------------------------------------

# The average self-reported confidence across all 7 agents (0.0–1.0 scale,
# converted from agent's 0–100 integer output) must reach this level for the
# council result to be labelled HIGH confidence.
# Only HIGH confidence allows a BUY signal to be issued.
# Default: 0.67
CONFIDENCE_HIGH_THRESHOLD=0.67

# Mean confidence floor for MEDIUM label. Below this = LOW confidence.
# Informational only — BUY signals require HIGH, not MEDIUM.
# Default: 0.40
CONFIDENCE_MEDIUM_THRESHOLD=0.40

# --- Scoring: probability-first gates -----------------------------------------

# Minimum council probability on the favored side for a market-aligned BUY.
# The council must believe the favored side has at least this probability.
# Example: council says EDG 62%, market says EDG 80% → 62% >= 60% → BUY NO.
# Default: 0.60
MIN_COUNCIL_PROBABILITY=0.60

# Minimum council probability for a CONTRARIAN BUY (going against market).
# Stricter than market-aligned because betting against consensus is riskier.
# Example: council says Wolves 72%, market says Wolves 20% → 72% >= 70% → BUY YES.
# Default: 0.70
MIN_CONTRARIAN_PROBABILITY=0.70

# Minimum per-side confidence for a CONTRARIAN BUY.
# Requires stronger data backing when going against market consensus.
# Default: 0.80
MIN_CONTRARIAN_CONFIDENCE=0.80

# --- Scoring: EV gate (PerceivedTrueWinRate + Kelly) --------------------------

# Master switch for the EV gate. When true, a BUY is downgraded to PASS with
# reason "Big Drawdown Risk" if side_price ≥ PerceivedTrueWinRate (the rolling
# correct_buy / total_resolved_buys ratio from history). Rejects bets that are
# mathematically -EV regardless of how confident the council is.
# Default: true
EV_GATE_ENABLED=true

# Minimum resolved BUY sample size before the EV gate activates. Below this,
# the gate stays dormant (too little data for a stable win-rate estimate).
# Raise for more conservative activation; lower for earlier enforcement.
# Default: 20
MIN_WIN_RATE_SAMPLES=20

# Kelly safety scaler applied to the advisory stake shown in the UI.
# 0.5 = half-Kelly (recommended — captures most growth, ~half the volatility).
# 1.0 = full Kelly (mathematically optimal but assumes win_rate is exact).
# Default: 0.5
KELLY_MULTIPLIER=0.5

# --- Scoring: agent weights ---------------------------------------------------

# How much extra weight the Rules Lawyer's confidence gets in the weighted
# scoring formula. At 2, the Rules Lawyer counts as two agents in the
# confidence-weighted average. Set to 1 for equal weight.
# Default: 1
RULES_LAWYER_WEIGHT=1

# How much weight the Bear agent's confidence gets in scoring. Default 1.0
# (equal to other agents). If the Bear's prompt fix doesn't improve its hit
# rate above 50% after 20+ entries, lower to 0.7 to reduce its drag on
# council confidence gating. Do not go below 0.5 — preserves contrarian value.
# Default: 1.0
BEAR_WEIGHT=1.0

# --- Scoring: dynamic per-agent reliability weights --------------------------

# Master switch for dynamic agent weighting. When true and an
# ~/.pqi/agent_weights.json snapshot exists, the computed per-agent weights
# FULLY OVERRIDE RULES_LAWYER_WEIGHT / BEAR_WEIGHT above (precedence mode α).
# To pin manual static weights instead, set this to false.
# Default: true
AGENT_WEIGHTS_ENABLED=true

# Minimum resolved lean verdicts required per agent before its dynamic weight
# deviates from 1.0. Below this, the agent falls back to 1.0 to avoid
# weighting on noisy small samples. Per-agent, not total.
# Default: 30
MIN_AGENT_WEIGHT_SAMPLES=30

# Shrinkage coefficient for the dynamic weight formula:
#   weight = 1.0 + shrink * (agent_lean_rate - council_avg_lean_rate)
# k=0.5 is a minimal nudge (weights ~0.93–1.02), k=2.0 is moderate
# (~0.71–1.08), k=4.0 is aggressive. Set to 0.0 to keep the file machinery
# live but disable the nudge (all weights snap to 1.0).
# Default: 2.0
AGENT_WEIGHT_SHRINK=2.0

# --- Council reliability -----------------------------------------------------

# Minimum number of agents (out of 7) that must return valid verdicts for the
# council result to be accepted. If fewer agents succeed after retries, the
# analysis is aborted. Default: 5
MIN_COUNCIL_VERDICTS=5

# Maximum retries per agent when an LLM call fails (timeout, rate limit, parse
# error). Uses exponential backoff: 1s, 2s, 4s, ... capped at 30s per wait.
# Failed API calls are not billed. Default: 5
AGENT_MAX_RETRIES=5

# --- Cache ------------------------------------------------------------------

# Path to the SQLite database used to cache council results.
# Cached results are reused if a market's price hasn't moved more than
# CACHE_PRICE_DELTA since the last run (saves API calls).
# Default: ~/.pqi/cache.db
# CACHE_DB_PATH=~/.pqi/cache.db

# Maximum YES-price movement (0.0–1.0) before a cached result is considered
# stale and the council is re-run. E.g. 0.02 = within 2 percentage points.
# Default: 0.02
CACHE_PRICE_DELTA=0.02

# Path to the JSON file caching resolved category lookups (--category arg →
# series_id or tag_id). Tag/series IDs on Polymarket are effectively immutable,
# so the cache has no TTL — only positive resolutions are written, misses
# fall through to the live three-pass resolver. Delete the file to force a
# refresh.
# Default: ~/.pqi/category_cache.json
# CATEGORY_CACHE_PATH=~/.pqi/category_cache.json

# --- Logging ----------------------------------------------------------------

# Log verbosity. Valid values: DEBUG | INFO | WARNING | ERROR
# Use DEBUG to see every LLM request and raw response.
# Default: INFO
LOG_LEVEL=INFO
