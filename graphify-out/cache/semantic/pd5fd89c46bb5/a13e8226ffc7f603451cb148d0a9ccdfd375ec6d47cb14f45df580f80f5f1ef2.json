{"nodes": [{"id": "claude_pqi_project", "label": "PQI \u2014 Polymarket Qualitative Intelligence", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "Project Mission", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Identify mispriced odds in Polymarket event-driven prediction markets via a 7-agent LLM council; default Advisor mode keeps a human in the trade decision loop."}, {"id": "claude_council_of_seven", "label": "The Council of Seven", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "The Council of Seven", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Seven deliberately biased personas deliberate in parallel (never sequentially, no agent-to-agent talk) \u2014 disagreement is the point; flattening the biases is a regression."}, {"id": "claude_rules_lawyer", "label": "The Rules Lawyer", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "The Council of Seven", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Resolution criteria only; receives resolution_criteria injected first as source of truth overriding all other context; 2x weight."}, {"id": "claude_bull", "label": "The Bull (Favorite's Advocate)", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "The Council of Seven", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_bear", "label": "The Bear (Underdog's Advocate)", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "The Council of Seven", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The only structurally independent agent in the mirror-collapse diagnostics; preserving its independence is an explicit Phase 1 guard rail."}, {"id": "claude_statistician", "label": "The Base-Rate Statistician", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "The Council of Seven", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_sentiment", "label": "The Sentiment Analyst", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "The Council of Seven", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_specialist", "label": "The Domain Specialist", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "The Council of Seven", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_contrarian", "label": "The Contrarian", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "The Council of Seven", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_confidence_weighted_scoring", "label": "Confidence-Weighted Two-Sided Scoring", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "Scoring Formula", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "YES and NO scores are independent confidence-weighted averages; gate order price-floor \u2192 ceiling \u2192 contrarian \u2192 market-aligned \u2192 EV gate is a stability invariant."}, {"id": "claude_ev_gate", "label": "Banded EV Gate", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "Scoring Formula", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Runs last, only converts BUYs to PASS; band-specific Beta-binomial smoothed win rates (BAND_SHRINKAGE_K=5) replaced the scalar PerceivedTrueWinRate in session 31; dormant below MIN_WIN_RATE_SAMPLES to avoid fabricating statistical power."}, {"id": "claude_kelly_sizing", "label": "Kelly Sizing (Half-Kelly Advisory)", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "Scoring Formula", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Half-Kelly (KELLY_MULTIPLIER=0.5) absorbs per-band estimation noise; Kelly inputs must match the gate's banded inputs."}, {"id": "claude_two_sidedness_autonomy", "label": "Two-Sidedness Is Autonomy, Not Algebra", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": "The Council of Seven", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "YES and NO sides are autonomous signals: prices live on independent orderbooks (don't sum to 1 due to spread/vig), per-side confidences carry independent evidence weight; single probability field is a modeling simplification, not algebraic coupling."}, {"id": "claude_option_b_shadow_layer", "label": "Option B Shadow Layer", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "Aggregator stability", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "probability_yes/probability_no/probability_source persisted descriptively since session 26; scoring still aggregates the single probability field \u2014 step 5 blocked on signal quality, not sample count."}, {"id": "claude_shared_preamble_v2", "label": "V2 Shared Preamble (PERSONA_V2_PREAMBLE)", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "Current State", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Phase 1 stage-1 A/B lever live since session 41; must not be edited mid-measurement because content drift invalidates the tagged v2:preamble population."}, {"id": "claude_phase_0_edge_validation", "label": "Phase 0 \u2014 Edge Validation", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "Phase status", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Verdict inconclusive: council Brier 0.2176 beats 0.25 chance baseline by ~3pp, mean pre-event CLV \u22120.0167, realized April PnL \u22120.575/share; explicitly no knob changes to avoid overfitting on the rows that produced band_stats."}, {"id": "claude_phase_1_signal_quality", "label": "Phase 1 \u2014 Signal Quality (Autonomy Fix)", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "Phase status", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Highest-leverage move per the Phase 0 verdict: the aggregate is fragile because 5 of 7 agents mirror each other; fix SHARED_PREAMBLE autonomy framing before any Option B backtest."}, {"id": "claude_phase_2b_mfe_analysis", "label": "Phase 2b \u2014 MFE Analysis", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "Phase status", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_llm_client_contract", "label": "LLM Client Contract (pqi/llm/client.py chat())", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "LLM Client Contract", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Single chat() entrypoint; LLM_BACKEND env swaps Ollama vs Anthropic; never import anthropic/ollama elsewhere so retry, caching, and kill switches stay centralized."}, {"id": "claude_anthropic_prompt_caching", "label": "Anthropic Prompt Caching", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "LLM Client Contract", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_anthropic_retry", "label": "Centralized Anthropic Retry", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "LLM Client Contract", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "SDK auto-retry disabled so _chat_anthropic owns the exponential-backoff schedule end-to-end; retryable 5xx incl. 529, 429, connection/timeout; non-retryable 4xx escapes immediately."}, {"id": "claude_squad_value_enrichment", "label": "Squad Market-Value Enrichment (Transfermarkt)", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "Current State", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Session 49 ingestion-only track: one descriptive key_context line (squad-value imbalance as a noisy strength proxy) for soccer national-team fixtures; never feeds scoring; non-fatal; public test instance is fragile \u2014 Phase 2 moves to dataset-primary."}, {"id": "claude_live_event_grace", "label": "Live-Event Grace (LIVE_EVENT_GRACE_HOURS)", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "Current State", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Polymarket stamps soccer endDate at kickoff (esports at kickoff+6h), so the server-side end_date_min=now filter silently dropped in-progress soccer; --live/--starts-within relax end_date_min by 3.0h sized to a match's real max length."}, {"id": "claude_structured_match_resolver", "label": "Structured-Match Resolver (Provider Adapter Layer)", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "What's live", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "PandaScoreProvider (esports) + FootballDataProvider (soccer) behind one StructuredMatchProvider interface; non-fatal contract \u2014 any failure yields structured_match=None and the pipeline continues."}, {"id": "claude_dynamic_agent_weights", "label": "Dynamic Per-Agent Reliability Weights", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "What's live", "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "claude_pqi_project", "target": "claude_council_of_seven", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "CLAUDE.md", "source_location": "Project Mission", "weight": 1.0}, {"source": "claude_council_of_s