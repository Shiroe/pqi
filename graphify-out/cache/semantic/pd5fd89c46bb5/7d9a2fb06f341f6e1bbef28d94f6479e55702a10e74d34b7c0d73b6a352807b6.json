{"nodes": [{"id": "docs_squad_value_enrichment_plan_squad_value_enrichment_plan", "label": "Squad Market-Value Enrichment Plan", "file_type": "document", "source_file": "docs/squad_value_enrichment_plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Large squad-value imbalances (France EUR1.5bn vs Iran EUR32M) carry information about likely results; surface the imbalance as one qualitative briefing fact and let the seven agents weigh it as a noisy proxy \u2014 never scoring."}, {"id": "docs_squad_value_enrichment_plan_team_valuation_source", "label": "TeamValuationSource ABC", "file_type": "concept", "source_file": "docs/squad_value_enrichment_plan.md", "source_location": "\u00a73.2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Squad value is team-level and slow-moving \u2014 a different concern from match-level StructuredMatchRecord; bolting it onto the match provider would violate SRP/DIP, so it is a parallel enrichment dimension mirroring the providers/ adapter."}, {"id": "docs_squad_value_enrichment_plan_transfermarkt_live_source", "label": "Transfermarkt Live Source", "file_type": "concept", "source_file": "docs/squad_value_enrichment_plan.md", "source_location": "\u00a72.2 Route A", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "felipeall/transfermarkt-api public test instance: aggregate squad value is on the /clubs/search hit itself (no per-player summing); risks are ToS-gray scraping, ~2req/3s rate limit, and a test-grade instance \u2014 self-host for production (TRANSFERMARKT_API_BASE is a config knob so the swap is config-only). Senior-team disambiguation excludes U21/U19/women."}, {"id": "docs_squad_value_enrichment_plan_squad_valuation_model", "label": "SquadValuation Pydantic Contract", "file_type": "concept", "source_file": "docs/squad_value_enrichment_plan.md", "source_location": "\u00a73.3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "TeamValuation + matchup-level SquadValuation (favorite_name, value_ratio) on BriefingDocument.squad_valuation; only typed models cross module boundaries; persisted per run from day one so value-imbalance vs outcome is measurable retroactively."}, {"id": "docs_squad_value_enrichment_plan_key_context_injection", "label": "key_context Briefing-Line Injection", "file_type": "concept", "source_file": "docs/squad_value_enrichment_plan.md", "source_location": "\u00a73.4", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One rendered line labeled 'noisy proxy' appended to key_context (which every agent already receives) \u2014 zero council.py and zero prompt change, the strongest possible read of 'don't affect the reasoning machine'; suppressed if either side's value is missing."}, {"id": "docs_squad_value_enrichment_plan_route_c_hybrid", "label": "Route C: Dataset-Primary + Live Fallback", "file_type": "concept", "source_file": "docs/squad_value_enrichment_plan.md", "source_location": "\u00a77 Phase 2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Phase 2 end-state: transfermarkt-datasets DuckDB snapshot as primary (robust, no live scrape in the hot path, historical values enable backtests) with the live public-instance source demoted to fallback."}], "edges": [{"source": "docs_soccer_structured_data_plan_transfermarkt_parked", "target": "docs_squad_value_enrichment_plan_transfermarkt_live_source", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/squad_value_enrichment_plan.md", "source_location": "\u00a71", "weight": 1.0}, {"source": "docs_squad_value_enrichment_plan_squad_value_enrichment_plan", "target": "docs_squad_value_enrichment_plan_team_valuation_source", "relation": "references", "confidence": "EXTRACTED", "confiden