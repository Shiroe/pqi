{"nodes": [{"id": "docs_cto_agent_persona", "label": "CTO Agent Reviewer Persona", "file_type": "document", "source_file": "docs/CTO_Agent.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Guardian of edge, math, and architectural purity; four review modes in priority order: quantitative validation, edge assessment, architectural judgment, code/contract review \u2014 most mistakes come from letting mode 4 dominate."}, {"id": "docs_cto_agent_edge_first", "label": "Edge First, Scale Second", "file_type": "rationale", "source_file": "docs/CTO_Agent.md", "source_location": "\u00a71 Core Philosophy", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A fast pipeline with no alpha is expensive telemetry; validate edge on held-out data before approving infrastructure migrations."}, {"id": "docs_cto_agent_parallel_is_not_diverse", "label": "Parallel Is Not Diverse", "file_type": "rationale", "source_file": "docs/CTO_Agent.md", "source_location": "\u00a71 Core Philosophy", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Running N agents concurrently does not guarantee N independent signals \u2014 diversity is a measurement (pairwise correlation, Brier, drift), not an assertion."}, {"id": "docs_cto_agent_mirror_collapse", "label": "Mirror Collapse", "file_type": "concept", "source_file": "docs/CTO_Agent.md", "source_location": "\u00a72 Quantitative Guardrails", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A signal-quality bug, not a sample-count bug: when agents converge to |drift| \u2248 0 you have one signal wearing seven hats; only prompt/evidence-structure/retrieval-diversity changes help, not more data."}, {"id": "docs_cto_agent_pre_event_clv", "label": "Pre-Event CLV", "file_type": "concept", "source_file": "docs/CTO_Agent.md", "source_location": "\u00a75 Strategic / Edge Awareness", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Polymarket has no mid-price close; price at event start vs entry price measures prediction edge independently of the eventual winner, capturable retroactively from CLOB hourly history."}, {"id": "docs_cto_agent_mfe", "label": "Max Favorable Excursion (MFE)", "file_type": "concept", "source_file": "docs/CTO_Agent.md", "source_location": "\u00a75 Strategic / Edge Awareness", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Highest price a position traded at before resolution \u2014 the opportunity cost of not taking profit; capturing it as realized PnL requires a continuous listener since Polymarket has no native stop-loss/bracket orders."}, {"id": "docs_cto_agent_capacity_edge", "label": "Capacity as Third Edge Axis", "file_type": "concept", "source_file": "docs/CTO_Agent.md", "source_location": "\u00a75 Strategic / Edge Awareness", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Prediction and execution edge are meaningless above the bankroll where Kelly-sized stakes cannot fill without eating the spread; Tier 2/3 eSports markets often have <$500 depth."}, {"id": "docs_cto_agent_gate_ordering", "label": "Gate Ordering Invariant", "file_type": "concept", "source_file": "docs/CTO_Agent.md", "source_location": "\u00a74 Technical Guardrails", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "price-floor \u2192 price-ceiling \u2192 contrarian \u2192 market-aligned \u2192 EV gate; EV gate runs last and only converts BUYs to PASS, never creates a BUY."}, {"id": "docs_cto_agent_monolith_first", "label": "Monolith-First, Containers Later", "file_type": "rationale", "source_file": "docs/CTO_Agent.md", "source_location": "\u00a73 Architectural Judgment", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "