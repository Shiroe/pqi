{"nodes": [{"id": "docs_scoring_reference_scoring_reference", "label": "Scoring Reference", "file_type": "document", "source_file": "docs/scoring-reference.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_scoring_reference_two_sided_score", "label": "Two-Sided Confidence-Weighted Score", "file_type": "concept", "source_file": "docs/scoring-reference.md", "source_location": "## Two-sided score", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "yes_score and no_score computed independently with their own confidence weights (prob_no = 1 - prob_yes today); an agent can be highly confident about one side and uncertain about the other."}, {"id": "docs_scoring_reference_gate_order", "label": "Recommendation Gate Order", "file_type": "concept", "source_file": "docs/scoring-reference.md", "source_location": "### Gate order", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Price floor (0.09) \u2192 price ceiling (0.90) \u2192 contrarian gate (prob>=0.60, conf>=0.80, ROI>=0.20) \u2192 market-aligned gate (prob>=0.60, conf>=0.67, ROI>=0.10) \u2192 banded EV gate last; signal types HIGH/MODERATE VALUE and LOW MARGIN by ROI band."}, {"id": "docs_scoring_reference_banded_ev_gate", "label": "Banded EV Gate", "file_type": "concept", "source_file": "docs/scoring-reference.md", "source_location": "gate 5", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Final arbiter: reject a BUY when side_price >= band_wr, the Beta-binomial smoothed win rate for the price band; dormant below MIN_WIN_RATE_SAMPLES=20; falls back to scalar PerceivedTrueWinRate when band stats absent."}, {"id": "docs_scoring_reference_perceived_true_win_rate", "label": "PerceivedTrueWinRate", "file_type": "concept", "source_file": "docs/scoring-reference.md", "source_location": "## PerceivedTrueWinRate + Kelly", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Rolling correct_buy/wrong_buy rate recomputed from history.jsonl after every sync, persisted to stats.json with per-band smoothed rates \u2014 feeds both the EV gate and Kelly sizing."}, {"id": "docs_scoring_reference_kelly_fraction", "label": "Kelly Sizing (Half-Kelly)", "file_type": "concept", "source_file": "docs/scoring-reference.md", "source_location": "kelly_fraction", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "f* = (bp - q)/b with KELLY_MULTIPLIER=0.5; uses the banded threshold so gate-accepted bets always carry non-zero advisory stake \u2014 half-Kelly absorbs per-band estimation noise."}, {"id": "docs_scoring_reference_beta_binomial_smoothing", "label": "Beta-Binomial Band Smoothing", "file_type": "concept", "source_file": "docs/scoring-reference.md", "source_location": "### Band boundaries", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "smoothed_wr = (wins + k*global_wr)/(n + k): empty bands fall back to global exactly, thin bands pull toward global, dense bands dominate. Band boundaries are a code constant \u2014 changing them is a re-analysis decision, not a knob."}], "edges": [{"source": "docs_scoring_reference_scoring_reference", "target": "docs_scoring_reference_two_sided_score", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/scoring-reference.md", "source_location": null, "weight": 1.0}, {"source": "docs_scoring_reference_scoring_reference", "target": "docs_scoring_reference_gate_order", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/scoring-reference.md", "source_location": null, "weight": 1.0}, {"source": "docs_scoring_reference_scoring_reference", "target": "docs_scoring_reference_banded_ev_gate", "relation": "references", "confidence": "EXTRACTED", "confidence_score":