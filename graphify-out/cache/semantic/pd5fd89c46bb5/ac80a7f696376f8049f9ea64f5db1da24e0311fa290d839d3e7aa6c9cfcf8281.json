{"nodes": [{"id": "docs_scaling_assessment_scaling_assessment", "label": "v2.0 Scaling Assessment", "file_type": "document", "source_file": "docs/scaling_assessment.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "External RFC triage: ~40% of the proposed v2.0 already shipped, ~60% premature or wrong-tool; both external documents accepted the '68% WR' claim without validation. Replacement plan is five edge-first phases."}, {"id": "docs_scaling_assessment_wr_68_decomposition", "label": "68% WR Decomposition", "file_type": "concept", "source_file": "docs/scaling_assessment.md", "source_location": "\u00a74", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The headline number conflates ~55 resolved-BUY win rate (CI \u00b113pp) with ~2800 agent-level lean hits (not a betting win rate \u2014 no price/gate/sizing); the agent-level signal is only meaningful broken down by predicted-probability bucket, which is what the reliability diagram resolves."}, {"id": "docs_scaling_assessment_prediction_vs_execution_edge", "label": "Prediction Edge vs Execution Edge", "file_type": "rationale", "source_file": "docs/scaling_assessment.md", "source_location": "\u00a76", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Two orthogonal edge sources: predicting P(YES) better than the market (validated via CLV/Brier) vs exit discipline on mid-event excursions (requires continuous monitoring). A 'listener' proposal sits differently depending on which edge it serves; the defensible prototype is the execution-edge framing."}, {"id": "docs_scaling_assessment_duckdb_over_postgres", "label": "DuckDB over PostgreSQL", "file_type": "rationale", "source_file": "docs/scaling_assessment.md", "source_location": "\u00a77", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The real problem is queryability, not concurrency or scale: DuckDB reads history.jsonl natively with full analytical SQL, zero ops, half-day wire-up. Postgres solves problems this project doesn't have."}, {"id": "docs_scaling_assessment_clv_framing_correction", "label": "CLV Framing Correction", "file_type": "concept", "source_file": "docs/scaling_assessment.md", "source_location": "\u00a75", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Sportsbook CLV is wrong for Polymarket (markets resolve to 1.00/0.00, no mid-price close); the three distinct edge measurements are pre-event CLV, MFE, and calibration/Brier \u2014 never conflate them."}], "edges": [{"source": "docs_scaling_assessment_scaling_assessment", "target": "docs_scaling_assessment_wr_68_decomposition", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/scaling_assessment.md", "source_location": "\u00a74", "weight": 1.0}, {"source": "docs_scaling_assessment_scaling_assessment", "target": "docs_scaling_assessment_prediction_vs_execution_edge", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/scaling_assessment.md", "source_location": "\u00a76", "weight": 1.0}, {"source": "docs_scaling_assessment_scaling_assessment", "target": "docs_scaling_assessment_duckdb_over_postgres", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/scaling_assessment.md", "source_location": "\u00a77", "weight": 1.0}, {"source": "docs_scaling_assessment_scaling_assessment", "target": "docs_scaling_assessment_clv_framing_correction", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/scaling_assessment.md", "source_location": "\u00a75", "weight": 1.0}, {"source": "docs_scaling_assessment_wr_68_decomposition", "target": "docs_phases_phase_0_edge_validation_reliability_diagram", "relation": "references", "confidence": "EXTRACTED", "conf