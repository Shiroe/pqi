{"nodes": [{"id": "docs_phases_phase_4_scaling_triggers_phase_4_conditional_scaling", "label": "Phase 4: Conditional Scaling (Trigger-Driven)", "file_type": "document", "source_file": "docs/phases/phase_4_scaling_triggers.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_phases_phase_4_scaling_triggers_trigger_driven_scaling", "label": "Measured-Trigger Principle", "file_type": "rationale", "source_file": "docs/phases/phase_4_scaling_triggers.md", "source_location": "## Principle", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A migration is justified only by a measured bottleneck \u2014 name the metric, threshold, and monitoring; absent that, it is speculative rearrangement. Every deferred item pairs a trigger, a response, and a non-goal."}, {"id": "docs_phases_phase_4_scaling_triggers_postgresql_migration", "label": "Deferred: PostgreSQL Migration", "file_type": "concept", "source_file": "docs/phases/phase_4_scaling_triggers.md", "source_location": "4.1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Trigger: >10k history rows with DuckDB >5s, concurrent writers, or multi-tenant. Response migrates rollups only \u2014 history.jsonl stays the auditable source of truth."}, {"id": "docs_phases_phase_4_scaling_triggers_llm_gateway", "label": "Deferred: LLM Gateway (LiteLLM)", "file_type": "concept", "source_file": "docs/phases/phase_4_scaling_triggers.md", "source_location": "4.2", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_phases_phase_4_scaling_triggers_redis_message_broker", "label": "Deferred: Redis Message Broker", "file_type": "concept", "source_file": "docs/phases/phase_4_scaling_triggers.md", "source_location": "4.3", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_phases_phase_4_scaling_triggers_microservices_decomposition", "label": "Deferred: Microservices Decomposition", "file_type": "concept", "source_file": "docs/phases/phase_4_scaling_triggers.md", "source_location": "4.4", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Extract only the one component with a triggering requirement; the 7-agent council stays in-process \u2014 agent parallelism is an asyncio concern, not a service boundary."}, {"id": "docs_phases_phase_4_scaling_triggers_websocket_ingestion", "label": "Deferred: Event-Driven Ingestion (WebSockets)", "file_type": "concept", "source_file": "docs/phases/phase_4_scaling_triggers.md", "source_location": "4.6", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Trigger: MFE analysis shows measurable PnL lost to polling granularity. Add per-category, not globally \u2014 polling is simpler and adequate for most markets."}], "edges": [{"source": "docs_phases_phase_4_scaling_triggers_phase_4_conditional_scaling", "target": "docs_phases_phase_4_scaling_triggers_trigger_driven_scaling", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/phases/phase_4_scaling_triggers.md", "source_location": null, "weight": 1.0}, {"source": "docs_phases_phase_4_scaling_triggers_trigger_driven_scaling", "target": "docs_phases_phase_4_scaling_triggers_postgresql_migration", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/phases/phase_4_scaling_triggers.md", "source_location": "4.1", "weight": 1.0}, {"source": "docs_phases_phase_4_scaling_triggers_trigger_driven_scaling", "target": "docs_phases_phase_4_scaling_triggers_llm_gateway", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/phases/phase_4_scaling_triggers.md", "source_location": "4.2", "weight": 1.0}, {"source": "docs_phases_phase_4_scaling_triggers_trigger_driven_scaling", "target": "do