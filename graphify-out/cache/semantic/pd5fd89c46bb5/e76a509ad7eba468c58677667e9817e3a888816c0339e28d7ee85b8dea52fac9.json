{"nodes": [{"id": "docs_retrospectives_phase_0_edge_2026_04_phase_0_edge_retrospective", "label": "Phase 0 Edge Validation Retrospective", "file_type": "document", "source_file": "docs/retrospectives/phase_0_edge_2026_04.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_retrospectives_phase_0_edge_2026_04_inconclusive_verdict", "label": "Phase 0 Verdict: Inconclusive", "file_type": "concept", "source_file": "docs/retrospectives/phase_0_edge_2026_04.md", "source_location": "\u00a70 / \u00a76", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Mild positive prediction edge, mild negative entry timing, no actionable gate miscalibration \u2014 none clears a statistically significant threshold at current n; realized April PnL ~zero. The edge exists marginally, concentrated in the council aggregate, fragile because agent diversity is only partly real."}, {"id": "docs_retrospectives_phase_0_edge_2026_04_council_brier", "label": "Council Brier 0.2176", "file_type": "concept", "source_file": "docs/retrospectives/phase_0_edge_2026_04.md", "source_location": "\u00a75.1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Beats the 0.25 always-0.5 chance baseline by ~3pp on n=385 \u2014 the strongest single signal of real prediction edge; confidence-weighted aggregation buys real (if small) signal."}, {"id": "docs_retrospectives_phase_0_edge_2026_04_pre_event_clv", "label": "Pre-Event CLV -0.0167", "file_type": "concept", "source_file": "docs/retrospectives/phase_0_edge_2026_04.md", "source_location": "\u00a74", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Mean -1.7pp adverse entry on n=44 (CI straddles zero): direction is real-enough to note, magnitude too loose to claim 'we always enter late'. Valorant -0.032 worst, LoL -0.001 neutral. CLV-vs-outcome join shows no monotone gradient \u2014 execution quality may be decoupled from prediction quality."}, {"id": "docs_retrospectives_phase_0_edge_2026_04_cluster_collapse_finding", "label": "5-Agent Cluster Collapse Finding (\u00a75.3)", "file_type": "concept", "source_file": "docs/retrospectives/phase_0_edge_2026_04.md", "source_location": "\u00a75.3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "9/21 pairs at r>=0.85 forming a rules_lawyer/statistician/sentiment/specialist/contrarian cluster; Bull weakly attached (~0.6); Bear uncorrelated. Refines 'mirror collapse': five converged to one signal, not seven \u2014 the single most important finding for Phase 1 priority."}, {"id": "docs_retrospectives_phase_0_edge_2026_04_bear_miscalibration", "label": "Bear Miscalibration (Brier 0.2810)", "file_type": "concept", "source_file": "docs/retrospectives/phase_0_edge_2026_04.md", "source_location": "\u00a75.1-5.2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Only agent above the chance baseline; predicts mean 0.356, realizes 0.484 on its [0.09,0.50) concentration band (+0.128 gap, n=351) \u2014 systematic under-prediction of YES. Bear's sole virtue is structural independence; fixing calibration without collapsing it into the cluster is the highest-value single change."}, {"id": "docs_retrospectives_phase_0_edge_2026_04_band_shrinkage_k_keep_5", "label": "BAND_SHRINKAGE_K: Keep K=5", "file_type": "concept", "source_file": "docs/retrospectives/phase_0_edge_2026_04.md", "source_location": "\u00a73", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "K moves the [0.50,0.60) and [0.80,0.95) thresholds in opposite directions (raw WRs straddle the global); picking K on the same 62 rows that produced band_stats is dressed-up overfitting. Revisit at band n>=20 or with a pre-registered hold-out."}], "edges": [{"source": "docs_retrospectives_phase_0_edge_2026_04_phase_0_edge_retrospective", "target": "docs_retrospectives_phase_0_edge_2026_04_inconclusive_verdict", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/retrospectives/phase_0_edge_2026_04.md", "source_location": "\u00a70", "weight": 1.0}, {"source": "docs_retrospectives_phase_0_edge_2026_04_phase_0_edge_retrospective", "target": "docs_retrospectives_phase_0_edge_2026_04_council_brier", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/retrospectives/phase_0_edge_2026_04.md", "source_location": "\u00a75.1", "weight": 1.0}, {"source": "docs_retrospectives_phase_0_edge_2026_04_phase_0_edge_retrospective", "target": "docs_retrospectives_phase_0_edge_2026_04_pre_event_clv", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/retrospectives/phase_0_edge_2026_04.md", "source_location": "\u00a74", "weight": 1.0}, {"source": "docs_retrospectives_phase_0_edge_2026_04_phase_0_edge_retrospective", "target": "docs_retrospectives_phase_0_edge_2026_04_cluster_collapse_finding", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/retrospectives/phase_0_edge_2026_04.md", "source_location": "\u00a75.3", "weight": 1.0}, {"source": "docs_retrospectives_phase_0_edge_2026_04_phase_0_edge_retrospective", "target": "docs_retrospectives_phase_0_edge_2026_04_bear_miscalibration", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/retrospectives/phase_0_edge_2026_04.md", "source_location": "\u00a75.1-5.2", "weight": 1.0}, {"source": "docs_retrospectives_phase_0_edge_2026_04_phase_0_edge_retrospective", "target": "docs_retrospectives_phase_0_edge_2026_04_band_shrinkage_k_keep_5", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/retrospectives/phase_0_edge_2026_04.md", "source_location": "\u00a73", "weight": 1.0}, {"source": 