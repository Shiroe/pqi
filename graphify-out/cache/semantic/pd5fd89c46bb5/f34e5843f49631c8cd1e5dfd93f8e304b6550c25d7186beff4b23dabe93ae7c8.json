{"nodes": [{"id": "docs_retrospectives_eval_gate_audit_2026_04_15_gate_ev_audit", "label": "Gate and EV Audit (Session 24)", "file_type": "document", "source_file": "docs/retrospectives/eval_gate_audit_2026_04_15.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Observation-only audit of 240 non-legacy runs / 50 resolved BUYs at 70% WR; the WR drop from 80% is the sample growing large enough to stop being flattered by lucky early bets, not a regression."}, {"id": "docs_retrospectives_eval_gate_audit_2026_04_15_buy_side_asymmetry", "label": "BUY YES vs BUY NO Asymmetry", "file_type": "concept", "source_file": "docs/retrospectives/eval_gate_audit_2026_04_15.md", "source_location": "\u00a73.1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "BUY NO hits 90% (n=10) vs BUY YES 65% \u2014 when the council disagrees enough to flip against an implied favorite it is disproportionately right; any future side-specific treatment should boost BUY NO."}, {"id": "docs_retrospectives_eval_gate_audit_2026_04_15_ev_gate_opportunity_cost", "label": "EV Gate Historical Opportunity Cost", "file_type": "concept", "source_file": "docs/retrospectives/eval_gate_audit_2026_04_15.md", "source_location": "\u00a73.3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Replaying the WR=0.70 scalar gate would have blocked 22 correct BUYs to avoid 5 wrong ones (4.4x opportunity cost) because correct BUYs cluster at high prices \u2014 the finding that motivated per-band gating (roadmap A.5, shipped session 31)."}, {"id": "docs_retrospectives_eval_gate_audit_2026_04_15_confidence_gate_dominance", "label": "Confidence Gate Dominance", "file_type": "concept", "source_file": "docs/retrospectives/eval_gate_audit_2026_04_15.md", "source_location": "\u00a73.6-3.7", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The 67% confidence floor blocks 45/46 (98%) missed opportunities while HIGH-conf PASSes become misses <2% of the time \u2014 the floor is expensive in misses but cheap in false BUYs; EV/ROI gates are redundant safety nets."}, {"id": "docs_retrospectives_eval_gate_audit_2026_04_15_bear_rewrite_validation", "label": "Bear Rewrite Validation (Session 20)", "file_type": "concept", "source_file": "docs/retrospectives/eval_gate_audit_2026_04_15.md", "source_location": "\u00a73.4", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Post-rewrite Bear lean-hit is 50.2% (from 38% with 81% NO-bias) \u2014 coin-flip is the structural target for a dedicated underdog advocate; Bear is no longer a degenerate voice."}], "edges": [{"source": "docs_retrospectives_eval_gate_audit_2026_04_15_gate_ev_audit", "target": "docs_retrospectives_eval_gate_audit_2026_04_15_buy_side_asymmetry", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/retrospectives/eval_gate_audit_2026_04_15.md", "source_location": "\u00a73.1", "weight": 1.0}, {"source": "docs_retrospectives_eval_gate_audit_2026_04_15_gate_ev_audit", "target": "docs_retrospectives_eval_gate_audit_2026_04_15_ev_gate_opportunity_cost", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/retrospectives/eval_gate_audit_2026_04_15.md", "source_location": "\u00a73.3", "weight": 1.0}, {"source": "docs_retrospectives_eval_gate_audit_2026_04_15_gate_ev_audit", "target": "docs_retrospectives_eval_gate_audit_2026_04_15_confidence_gate_dominance", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/retrospectives/eval_gate_audit_2026_04_15.md", "source_location": "\u00a73.6", "weight": 1.0}, {"source": "docs_retrospectives_eval_gate_audit_2026_04_15_gate_ev_audit", "target": "docs_retrospectives_eval_gate_audit_2026_04_15_bear_rewrite_validation", "relation": "r