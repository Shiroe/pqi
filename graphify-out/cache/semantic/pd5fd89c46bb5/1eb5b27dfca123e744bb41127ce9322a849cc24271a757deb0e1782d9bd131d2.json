{"nodes": [{"id": "docs_phases_phase_2a_tier_a_auto_buy_phase_2a_tier_a_auto_buy", "label": "Phase 2a: Tier A Auto-BUY", "file_type": "document", "source_file": "docs/phases/phase_2a_tier_a_auto_buy.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Tier A automates entry only and holds to resolution \u2014 it needs the council signal to be trustworthy (Phase 1) but not MFE validation; splitting it from the old execution-edge bundle keeps the critical path clean."}, {"id": "docs_phases_phase_2a_tier_a_auto_buy_pqi_buy_command", "label": "pqi buy Command", "file_type": "concept", "source_file": "docs/phases/phase_2a_tier_a_auto_buy.md", "source_location": "Task 2a.1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Narrowest possible Tier A surface: one market, one decision, no continuous state. Kelly-sized stake from kelly_stake_scaled, structured logging to fills.jsonl."}, {"id": "docs_phases_phase_2a_tier_a_auto_buy_idempotency_guard", "label": "Idempotency Guard", "file_type": "concept", "source_file": "docs/phases/phase_2a_tier_a_auto_buy.md", "source_location": "Task 2a.1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Hash (market_id, analysis_run_id) into a deterministic key; refuse a second fill for the same pair so retriggered analyses cannot double-fill."}, {"id": "docs_phases_phase_2a_tier_a_auto_buy_pre_trade_drift_abort", "label": "Pre-Trade Price Drift Abort", "file_type": "concept", "source_file": "docs/phases/phase_2a_tier_a_auto_buy.md", "source_location": "Task 2a.1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Kelly stake and ROI were priced at analyze-time; if top-of-book moved more than TIER_A_PRICE_DRIFT_ABORT_PCT (3%) the assumptions are invalid \u2014 abort rather than fill."}, {"id": "docs_phases_phase_2a_tier_a_auto_buy_ghost_event_probing", "label": "Ghost-Event ID-Based Probing", "file_type": "concept", "source_file": "docs/phases/phase_2a_tier_a_auto_buy.md", "source_location": "Task 2a.3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Gamma list endpoints intermittently drop events; probe /events/{id} individually before deciding an event is gone. Optional insurance for Tier A, mandatory for Tier B position monitoring."}, {"id": "docs_phases_phase_2a_tier_a_auto_buy_first_10_fills_checklist", "label": "First-10-Fills Checklist", "file_type": "concept", "source_file": "docs/phases/phase_2a_tier_a_auto_buy.md", "source_location": "Task 2a.4", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Manual operator gate: first 10 fills reviewed by hand before --unattended is acceptable; live trading has surprise modes (broker rejects, partial fills, slippage) that are cheap to catch on a canary sample."}], "edges": [{"source": "docs_phases_phase_2a_tier_a_auto_buy_phase_2a_tier_a_auto_buy", "target": "docs_phases_phase_1_signal_quality_phase_1_signal_quality", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/phases/phase_2a_tier_a_auto_buy.md", "source_location": "Entry criteria", "weight": 1.0}, {"source": "docs_phases_phase_2a_tier_a_auto_buy_phase_2a_tier_a_auto_buy", "target": "docs_phases_phase_2a_tier_a_auto_buy_pqi_buy_command", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/phases/phase_2a_tier_a_auto_buy.md", "source_location": null, "weight": 1.0}, {"source": "docs_phases_phase_2a_tier_a_auto_buy_phase_2a_tier_a_auto_buy", "target": "docs_phases_phase_2a_tier_a_auto_buy_idempotency_guard", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/phases/phase_2a_tier_a_auto_buy.md", "source_location": null, "weight": 1.0}, {"source": "docs_phases_phase_2a_tier_a_aut