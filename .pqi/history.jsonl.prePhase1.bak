"volatility_24h": 2.1389249636207435, "direction": "FALLING", "sharp_moves": [{"timestamp": "2026-04-12T17:00:45Z", "delta_pp": 5.499999999999999}]}, "fetched_at": "2026-04-12T17:16:50.204161Z"}}}, "resolution": {"resolved_at": "2026-04-12T23:15:00Z", "winning_side": "YES", "final_yes_price": 1.0, "checked_at": "2026-04-13T00:24:25.688054+00:00", "source": "gamma_api"}, "analysis": null}
