hours from current time)"], "prior_match_facts": ["2026-01-26 \u2014 winner: Cloud9 (1-2) @ Playoffs", "2025-11-06 \u2014 winner: Team Envy (2-1) @ Group Stage"], "disambiguation_warnings": [], "data_freshness": "2026-04-17T18:41:21.837217Z", "price_history": {"yes": {"token_id": "5312052569409725791485279618248023948269957717024160264600419206032560872948", "data_points": 97, "weighted_avg": 0.6671076035070961, "change_1w_pp": 15.500000000000004, "change_24h_pp": -3.0000000000000027, "volatility_24h": 0.7743171827921013, "direction": "RISING", "sharp_moves": [{"timestamp": "2026-04-13T08:00:43Z", "delta_pp": 14.500000000000002}, {"timestamp": "2026-04-13T10:00:45Z", "delta_pp": 5.499999999999994}]}, "no": {"token_id": "88757173931573211189354686915016649151857196409264192635351297597995188666687", "data_points": 74, "weighted_avg": 0.33872396050248627, "change_1w_pp": -15.500000000000004, "change_24h_pp": 2.9999999999999973, "volatility_24h": 0.9660917830792952, "direction": "FALLING", "sharp_moves": [{"timestamp": "2026-04-13T08:00:47Z", "delta_pp": -14.500000000000002}, {"timestamp": "2026-04-13T10:00:50Z", "delta_pp": -5.499999999999999}]}, "fetched_at": "2026-04-17T18:41:22.154226Z"}, "structured_match": {"provider": "pandascore", "provider_match_id": "1411844", "game": "valorant", "scheduled_at": "2026-04-17T21:00:00Z", "status": "scheduled", "team_a_name": "Cloud9", "team_b_name": "Team Envy", "match_format": "BO3", "tournament_name": "Group Alpha", "final_score": null, "winner_name": null, "h2h": [{"match_id": "1288585", "scheduled_at": "2026-01-26T01:10:00Z", "winner_name": "Cloud9", "score_summary": "1-2", "tournament_name": "Playoffs"}, {"match_id": "1266000", "scheduled_at": "2025-11-06T22:20:00Z", "winner_name": "Team Envy", "score_summary": "2-1", "tournament_name": "Group Stage"}], "team_a_recent_form": {"team_name": "Cloud9", "matches_considered": 10, "wins": 4, "losses": 6, "last_match_at": "2026-04-12T21:00:00Z"}, "team_b_recent_form": {"team_name"