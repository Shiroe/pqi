ults provided limited direct information about the Invictus Gaming vs Top Esports BO3 match for the Esports World Cup China Qualifier Phase 2. The results included general organizational background on Invictus Gaming (founded 2011 by Wang SiCong) and scattered roster/competitive data from unrelated tournaments and regions. No specific match details, recent form data, head-to-head records, or qualifier standings were available in the search results.", "side_yes_case": ["Invictus Gaming is an established Chinese organization with significant backing and resources from Wang SiCong's wealth", "Unable to assess team strengths without current roster or recent performance data"], "side_no_case": ["Top Esports is a major Chinese LoL organization with competitive pedigree", "Unable to assess team weaknesses without current roster or recent performance data"], "key_context": ["Match is BO3 format for Esports World Cup China Qualifier Phase 2 \u2014 high stakes qualifier match", "No recent head-to-head record, current rosters, or recent form data available in search results", "Search results did not contain specific information about either team's current competitive standing or recent performance", "Insufficient data on meta, patch version, or other relevant competitive factors"], "data_freshness": "2026-04-13T23:22:51.369807Z", "price_history": {"yes": {"token_id": "94625042272564344801804488585225860650616778447812730853981941011385568297088", "data_points": 72, "weighted_avg": 0.4174316509030104, "change_1w_pp": -1.0000000000000009, "change_24h_pp": 7.000000000000001, "volatility_24h": 1.0000000000000013, "direction": "FALLING", "sharp_moves": []}, "no": {"token_id": "10796956428283163965849019862698814920332676682593018452759200668782986252749", "data_points": 143, "weighted_avg": 0.5814905869539976, "change_1w_pp": 1.0000000000000009, "change_24h_pp": -5.999999999999995, "volatility_24h": 1.146423008442221, "direction": "RISING", "sharp_moves": []}, "fetched_at": "2026-0