: Gen.G (1-3) @ Playoffs", "2025-08-23 \u2014 winner: Gen.G (1-2) @ Round 3-5 Legend Group", "2025-08-17 \u2014 winner: Gen.G (1-2) @ Round 3-5 Legend Group", "2025-07-23 \u2014 winner: Gen.G (2-0) @ Round 3-5 Legend Group", "2025-06-13 \u2014 winner: Gen.G (3-2) @ Road to MSI", "2025-05-21 \u2014 winner: Gen.G (2-1) @ Rounds 1-2", "2025-04-02 \u2014 winner: Gen.G (0-2) @ Rounds 1-2"], "disambiguation_warnings": [], "data_freshness": "2026-04-17T20:34:50.377476Z", "price_history": {"yes": {"token_id": "102113798807594224088954356412031379016822289611964256931298393106101028549026", "data_points": 56, "weighted_avg": 0.32438927540606627, "change_1w_pp": -17.5, "change_24h_pp": 1.0000000000000009, "volatility_24h": 0.901752679362165, "direction": "FALLING", "sharp_moves": [{"timestamp": "2026-04-13T03:00:55Z", "delta_pp": -12.5}, {"timestamp": "2026-04-13T11:00:58Z", "delta_pp": -7.000000000000001}]}, "no": {"token_id": "50885633542127276533086371398085696492087486009031666870662961203660331036715", "data_points": 26, "weighted_avg": 0.6780899462830289, "change_1w_pp": 17.500000000000004, "change_24h_pp": -2.9999999999999916, "volatility_24h": 0.5547001962252265, "direction": "RISING", "sharp_moves": [{"timestamp": "2026-04-13T04:00:57Z", "delta_pp": 12.5}, {"timestamp": "2026-04-13T12:00:04Z", "delta_pp": 6.000000000000005}]}, "fetched_at": "2026-04-17T20:34:50.693648Z"}, "structured_match": {"provider": "pandascore", "provider_match_id": "1413446", "game": "lol", "scheduled_at": "2026-04-18T08:00:00Z", "status": "scheduled", "team_a_name": "Hanwha Life Esports", "team_b_name": "Gen.G", "match_format": "BO3", "tournament_name": "Rounds 1-2", "final_score": null, "winner_name": null, "h2h": [{"match_id": "1309415", "scheduled_at": "2026-02-01T08:00:00Z", "winner_name": "Gen.G", "score_summary": "0-3", "tournament_name": "Group Stage"}, {"match_id": "1269919", "scheduled_at": "2025-12-08T06:45:00Z", "winner_name": "Hanwha Life Esports", "score_summary": "0-1", "tournam