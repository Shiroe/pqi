eams"], "side_no_case": ["Insufficient data on Alliance's current roster and recent performance trajectory", "Tricked showed mixed results in recent matches, losing to ECSTATIC in POWER Ligaen", "No clear evidence of Alliance's weakness or relative skill disadvantage in available information"], "key_context": ["Match is BO1 (best-of-one) format, which increases variance and upset potential", "Conquest of Prague Online Stage Group Stage indicates early tournament phase with potentially developing team forms", "Search results lack direct head-to-head history or recent roster rosters for either Alliance or Tricked", "Limited current tournament context available; insufficient recent form data for accurate assessment", "No recent player statistics or team rankings provided for either team in the search results"], "data_freshness": "2026-04-13T10:17:22.991305Z", "price_history": {"yes": {"token_id": "54841082120263203882468949702113856329676293514871979162827609352593863882897", "data_points": 14, "weighted_avg": 0.640832799538007, "change_1w_pp": 20.499999999999996, "change_24h_pp": 0.5000000000000004, "volatility_24h": 0.35355339059327406, "direction": "RISING", "sharp_moves": [{"timestamp": "2026-04-11T10:00:30Z", "delta_pp": 5.000000000000004}, {"timestamp": "2026-04-12T00:00:24Z", "delta_pp": -12.0}, {"timestamp": "2026-04-12T16:00:17Z", "delta_pp": 11.5}]}, "no": {"token_id": "69262330521477353750552702202110881608321889267143531295379212509172052530879", "data_points": 15, "weighted_avg": 0.35319390149761076, "change_1w_pp": -20.5, "change_24h_pp": -0.5000000000000004, "volatility_24h": 0.35355339059327406, "direction": "FALLING", "sharp_moves": [{"timestamp": "2026-04-10T23:00:23Z", "delta_pp": -10.500000000000004}, {"timestamp": "2026-04-12T00:00:21Z", "delta_pp": 12.0}, {"timestamp": "2026-04-12T16:00:14Z", "delta_pp": -11.5}]}, "fetched_at": "2026-04-13T10:17:23.549390Z"}}}, "resolution": {"resolved_at": "2026-04-13T22:00:00Z", "winning_side": "YES", "final_yes